<?xml version="1.0"?>
<package format="3">
  <name>airsim_px4_offboard</name>
  <version>1.0.0</version>
  <description>PX4-owned ROS 2 live control and AirSim camera synchronization.</description>

  <maintainer email="wouter.jansen@uantwerpen.be">Wouter Jansen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>airsim_interfaces</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
