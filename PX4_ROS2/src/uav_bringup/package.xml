<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and smoke tests for the UAV autonomy stack.
    Same nodes run in simulation and on hardware; only the launch file differs.
  </description>
  <maintainer email="ng.chi.nghi@gmail.com">nghi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>uav_px4_backend</exec_depend>
  <exec_depend>uav_localization</exec_depend>
  <exec_depend>uav_navigation</exec_depend>
  <exec_depend>uav_perception</exec_depend>
  <exec_depend>uav_world_model</exec_depend>
  <exec_depend>uav_control_authority</exec_depend>
  <exec_depend>uav_safety</exec_depend>
  <exec_depend>uav_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
