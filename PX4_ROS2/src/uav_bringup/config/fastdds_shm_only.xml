<!-- 🔴 MEASURED DEAD END for this project. Kept as evidence, NOT wired into any build.
     Do not add an env hook for this file: it severs PX4 from ROS.

     What it does: forces same-host DDS onto shared memory only.
     Why it looked right (2026-08-18): under WSL mirrored networking the Fast DDS UDP
     path is dead; default transport delivered 0/9 messages, SHM-only delivered 9/9.
     Why it is wrong here: the agent links Fast DDS 2.12.2, ROS Humble links 2.6.11.
     RTPS-over-UDP interoperates across those versions; the SHM segment layout does not.
     Result measured: ROS-to-ROS works (/clock visible), every /fmu/out/* disappears.

     Still useful for isolating a ROS-only discovery fault. See docs/ops-playbook.md 3. -->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_transport</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="shm_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
