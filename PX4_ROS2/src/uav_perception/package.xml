<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_perception</name>
  <version>0.1.0</version>
  <description>Observes the environment: camera stream health, markers, obstacles and target tracks. Camera drivers themselves belong to the hardware and arrive at P11; in simulation the uav_sim_gz bridge stands in for them.</description>
  <maintainer email="ng.chi.nghi@gmail.com">PX4_ROS2 team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>uav_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
