<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='uav0_nav'>
    <include merge='true'>
      <uri>model://uav0_frame</uri>
    </include>

    <!-- relative_to base_link, not model origin; see README pitfall 4. -->
    <include merge='true'>
      <uri>model://sensor_lidar_down</uri>
      <pose relative_to="base_link">0 0 -0.05 0 0 0</pose>
    </include>
    <joint name="LidarDownJoint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_lidar_down/base_link</child>
    </joint>

    <include merge='true'>
      <uri>model://sensor_camera_down</uri>
      <pose relative_to="base_link">0.06 0 -0.05 0 0 0</pose>
    </include>
    <joint name="CameraDownJoint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_camera_down/base_link</child>
    </joint>

    <!-- Ground truth, not real VIO; see README section 6. -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <!-- Renamed: PX4 gz_bridge fuses /odometry_with_covariance as vision. -->
      <odom_covariance_topic>/model/uav0_nav/odometry_cov_unused</odom_covariance_topic>
    </plugin>
  </model>
</sdf>
