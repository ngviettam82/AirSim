<?xml version="1.0"?>
<model>
  <name>target_box</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Mobile target for P9 follow_target / TrackTarget rehearsal: a 0.5 x 0.5 x 0.8 m
    box, collision equal to visual (CLAUDE.md S5). Velocity commanded at runtime via
    gz-sim-velocity-control-system on /model/&lt;spawned_name&gt;/cmd_vel; spawn with
    scripts/spawn_target_box.sh. Not referenced by any world file (P9-mission.md S3:
    the M5 baseline world must stay untouched) -- always spawned live.
  </description>
</model>
