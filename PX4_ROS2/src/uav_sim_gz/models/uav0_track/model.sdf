<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='uav0_track'>
    <include merge='true'>
      <uri>model://uav0_frame</uri>
    </include>

    <!-- Own modules, not PX4's OakD-Lite; see model-sources.md 2.3. -->
    <include merge='true'>
      <uri>model://sensor_camera_front</uri>
      <pose relative_to="base_link">.12 .03 .002 0 0 0</pose>
    </include>
    <joint name="CameraFrontJoint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_camera_front/base_link</child>
    </joint>

    <include merge='true'>
      <uri>model://sensor_depth_front</uri>
      <pose relative_to="base_link">.12 .03 .002 0 0 0</pose>
    </include>
    <joint name="DepthFrontJoint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_depth_front/base_link</child>
    </joint>

    <!-- Ground truth, not real VIO; see README section 6. -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <!-- Renamed: PX4 gz_bridge fuses /odometry_with_covariance as vision. -->
      <odom_covariance_topic>/model/uav0_track/odometry_cov_unused</odom_covariance_topic>
    </plugin>
  </model>
</sdf>
