<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='sensor_camera_down'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="sensor_camera_down/base_link">
      <inertial>
        <!-- Box approximation, 30x30x30 mm. Device not yet chosen. -->
        <mass>0.020</mass>
        <inertia>
          <ixx>0.000003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000003</iyy>
          <iyz>0</iyz>
          <izz>0.000003</izz>
        </inertia>
      </inertial>
      <visual name="sensor_camera_down/visual">
        <geometry>
          <box>
            <size>0.030 0.030 0.030</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.2 1</ambient>
          <diffuse>0.1 0.1 0.35 1</diffuse>
        </material>
      </visual>
      <sensor name="camera_down" type="camera">
        <!-- Pitch +90 deg turns sensor +X axis into body -Z. -->
        <pose>0 0 -0.015 0 1.5707963 0</pose>
        <!-- Own topic parent avoids camera_info collision; README pitfall 6. -->
        <topic>uav0/camera_down/image</topic>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.2217305</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
