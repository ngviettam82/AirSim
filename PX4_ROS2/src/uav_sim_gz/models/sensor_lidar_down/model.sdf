<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='sensor_lidar_down'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="sensor_lidar_down/base_link">
      <inertial>
        <!-- Box approximation, 35x35x20 mm. Device not yet chosen. -->
        <mass>0.010</mass>
        <inertia>
          <ixx>0.000001354</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001354</iyy>
          <iyz>0</iyz>
          <izz>0.000002042</izz>
        </inertia>
      </inertial>
      <visual name="sensor_lidar_down/visual">
        <geometry>
          <box>
            <size>0.035 0.035 0.020</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar_down" type="gpu_lidar">
        <!-- Pitch +90 deg turns sensor +X axis into body -Z. -->
        <pose>0 0 -0.010 0 1.5707963 0</pose>
        <topic>uav0/lidar_down</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <!-- Measured landed clearance is 0.177 m, so this keeps margin. -->
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
  </model>
</sdf>
