<?xml version="1.0"?>
<model>
  <name>uav0_nav_indoor</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>
  <description>
    Indoor configuration of uav0_nav. The hardware is identical; the airframe
    denies the GPS a fix and moves the height reference onto vision, which is
    what actually changes indoors.
  </description>
</model>
