<?xml version="1.0"?>
<model>
  <name>sensor_depth_front</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>
  <description>
    Forward depth camera module. Feeds obstacle extraction and 3D mapping.

    Replaces the depth half of PX4's OakD-Lite. Resolution is unchanged from it;
    the rate is halved, because the point cloud published alongside the depth
    image is the heaviest single stream crossing the ROS bridge.

    All numbers are placeholders pending device selection - see
    docs/model-sources.md before trusting them for flight.
  </description>
</model>
