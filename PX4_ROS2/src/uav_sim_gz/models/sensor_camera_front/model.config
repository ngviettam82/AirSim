<?xml version="1.0"?>
<model>
  <name>sensor_camera_front</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>
  <description>
    Forward RGB camera module. Feeds object detection and forward marker work.

    Replaces the RGB half of PX4's OakD-Lite, whose 1920x1080 at 30 Hz was a
    PX4 default rather than a choice of this project: bridging that stream into
    ROS cost about 186 MB/s and dropped the mean real-time factor to 0.667,
    below the 0.95 needed for a flight measurement to be trusted. See
    docs/model-sources.md.

    All numbers are placeholders pending device selection.
  </description>
</model>
