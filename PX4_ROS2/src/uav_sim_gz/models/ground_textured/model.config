<?xml version="1.0"?>
<model>
  <name>ground_textured</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>
  <description>
    Textured ground surface and the asset home for its three texture variants.
    Exists so optical flow has something to track: a plain surface yields none.
    Assets are generated at build time, never downloaded.
  </description>
</model>
