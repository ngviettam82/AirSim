<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_safety</name>
  <version>0.1.0</version>
  <description>High-level safety supervision: 12-code failsafe policy (REPORT/HOLD/INHIBIT), a latching FSM, and ClearFault. Does not replace PX4's core failsafe. safety_supervisor_node enforces the INHIBIT branch (P8.4) and the HOLD frozen-pose stream (P8.5).</description>
  <maintainer email="ng.chi.nghi@gmail.com">PX4_ROS2 team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Not used by failsafe_policy itself (ROS-free by design), declared
       for safety_supervisor_node, P8.3. -->
  <depend>rclcpp</depend>
  <depend>uav_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <!-- G-S1 (test_safety_cut_chain.cpp): the REAL control_authority_manager_node
       runs in the same test process as the real safety_supervisor_node, so
       the cut is proven through the ACTUAL arbiter, not a stand-in. -->
  <test_depend>uav_control_authority</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
