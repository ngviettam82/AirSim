<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_navigation</name>
  <version>0.1.0</version>
  <description>Turns a goal into motion: the action gateway the mission layer calls, route and local planning, trajectory generation and recovery. Publishes internal setpoints only; the PX4 backend owns every autopilot message.</description>
  <maintainer email="ng.chi.nghi@gmail.com">PX4_ROS2 team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>uav_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
