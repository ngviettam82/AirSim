void MainPS(in float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
    const int2 ScenePixel = int2(SvPosition.xy) - OutputTextureMin + SceneTextureMin;
    const float AirSimDeviceZ = AirSimDepthTexture.Load(int3(ScenePixel, 0)).r;
    const float SceneDeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(int3(ScenePixel, 0)).r;
    const bool AirSimDepthIsValid = abs(AirSimDeviceZ - FarDepthValue) > 1.0e-7;
#if HAS_INVERTED_Z_BUFFER
    const bool AirSimDepthIsVisible = AirSimDeviceZ + 1.0e-6 >= SceneDeviceZ;
#else
    const bool AirSimDepthIsVisible = AirSimDeviceZ <= SceneDeviceZ + 1.0e-6;
#endif
    const uint Label = AirSimDepthIsValid && AirSimDepthIsVisible
        ? AirSimStencilTexture.Load(int3(ScenePixel, 0)) STENCIL_COMPONENT_SWIZZLE
        : CalcSceneCustomStencil(ScenePixel);
    if (OutputMode == 1u)
    {
        const float Value = float(Label) / 255.0;
        OutColor = float4(Value, Value, Value, 1.0);
        return;
    }

    if (Label == 0u)
    {
        OutColor = float4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    const uint PackedColor = PublicSegmentationPalette[Label];
    const float3 Color = float3(
        (PackedColor >> 16u) & 0xFFu,
        (PackedColor >> 8u) & 0xFFu,
        PackedColor & 0xFFu) / 255.0;
    OutColor = float4(Color, 1.0);
}
